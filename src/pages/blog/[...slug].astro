---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import PostCard from '../../components/PostCard.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { CATEGORY_COLORS, categorySlug, relatedHeading } from '../../lib/categories';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const color = CATEGORY_COLORS[post.data.category];
const toc = headings.filter((h) => h.depth === 2);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  image={post.data.image}
>
  <article>
    <a class="tag" href={`/category/${categorySlug(post.data.category)}`} style={`color: ${color}`}>
      <CategoryIcon category={post.data.category} size={14} />
      {post.data.category}
    </a>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {post.data.updatedDate
        ? <>Updated {fmtDate(post.data.updatedDate)} &middot; First published {fmtDate(post.data.pubDate)}</>
        : <>Published {fmtDate(post.data.pubDate)}</>}
    </p>
    <img class="hero-image" src={post.data.image} alt={post.data.imageAlt} width="720" height="360" />
    {toc.length >= 4 && (
      <nav class="toc" aria-label="In this guide">
        <p class="toc-title">In this guide</p>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>

    <ShareLinks url={canonicalURL} title={post.data.title} />
  </article>

  {related.length > 0 && (
    <section class="related">
      <h2>{relatedHeading(post.data.category)}</h2>
      <div class="grid">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .tag:hover { text-decoration: underline; }
  h1 {
    font-size: 2rem;
    margin: 0.6rem 0 0.4rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }
  .toc {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .toc-title {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc ol {
    margin: 0;
    padding-left: 1.2rem;
    columns: 2;
    column-gap: 2rem;
    font-size: 0.92rem;
  }
  .toc li { margin: 0.25rem 0; break-inside: avoid; }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .toc ol { columns: 1; }
  }
  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .related h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .grid {
    display: grid;
    gap: 1.1rem;
  }
</style>
