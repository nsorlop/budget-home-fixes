---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { CATEGORY_COLORS, CATEGORY_DESCRIPTIONS, CATEGORY_PAGE_TITLES, categorySlug } from '../../lib/categories';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
const color = CATEGORY_COLORS[category];
const description = CATEGORY_DESCRIPTIONS[category];
const pageTitle = CATEGORY_PAGE_TITLES[category];
---
<BaseLayout title={pageTitle} description={description}>
  <div class="tag" style={`color: ${color}`}>
    <CategoryIcon category={category} size={16} />
    {category}
  </div>
  <h1>{pageTitle}</h1>
  <p class="subtitle">{description}</p>
  <p class="intro">
    {posts.length} {posts.length === 1 ? 'guide' : 'guides'} in this section, newest first. Each one lists its
    sources, shows where they disagree, and labels any figure that is our own arithmetic. Not sure where to
    begin? Open <a href={`/blog/${posts[0].id}`}>{posts[0].data.title}</a>, then follow the related guides at the bottom of the page.
  </p>

  <div class="grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <p class="back"><a href="/">&larr; All cost guides</a></p>
</BaseLayout>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  h1 { margin: 0.5rem 0 0.4rem; }
  .subtitle {
    color: var(--muted);
    margin: 0 0 2rem;
    max-width: 34rem;
  }
  .intro {
    margin: -1rem 0 2rem;
    max-width: 38rem;
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    gap: 1.1rem;
  }
  .back { margin-top: 2rem; }
  .back a { text-decoration: none; font-weight: 500; }
</style>
