---
interface Item {
  label: string;
  low: number;
  high: number;
  note?: string;
}
interface Props {
  title?: string;
  items: Item[];
  max?: number;
  caption?: string;
}
const { title, items, max, caption } = Astro.props;
const scaleMax = max ?? Math.ceil(Math.max(...items.map((i) => i.high)) * 1.05);
const fmt = (n: number) => '$' + n.toLocaleString('en-US');
const pct = (n: number) => Math.min(100, Math.max(0, (n / scaleMax) * 100));
---
<figure class="cost-range">
  {title && <p class="cr-title">{title}</p>}
  <ul>
    {items.map((item) => (
      <li>
        <div class="cr-head">
          <span class="cr-label">{item.label}</span>
          <span class="cr-value">{item.low === item.high ? fmt(item.low) : `${fmt(item.low)}–${fmt(item.high)}`}</span>
        </div>
        <div class="cr-track" aria-hidden="true">
          <span
            class="cr-bar"
            style={`left:${pct(item.low)}%; width:${Math.max(1.5, pct(item.high) - pct(item.low))}%`}
          ></span>
        </div>
        {item.note && <p class="cr-note">{item.note}</p>}
      </li>
    ))}
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cost-range {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .cr-title {
    margin: 0 0 0.9rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0 0 0.95rem; }
  li:last-child { margin-bottom: 0; }
  .cr-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.92rem;
    margin-bottom: 0.3rem;
  }
  .cr-label { font-weight: 600; }
  .cr-value { color: var(--accent-dark); font-weight: 600; white-space: nowrap; }
  .cr-track {
    position: relative;
    height: 10px;
    background: var(--accent-soft);
    border-radius: 999px;
    overflow: hidden;
  }
  .cr-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--accent);
    border-radius: 999px;
  }
  .cr-note { margin: 0.3rem 0 0; font-size: 0.82rem; color: var(--muted); }
  figcaption {
    margin-top: 0.9rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
