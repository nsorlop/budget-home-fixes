---
interface Props {
  category: 'Painting' | 'Wallpaper' | 'Kitchen' | 'Storage' | 'Guides';
  size?: number;
}
const { category, size = 16 } = Astro.props;
---
{category === 'Painting' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="14" height="6" rx="1.5"/><line x1="10" y1="10" x2="10" y2="15"/><line x1="10" y1="15" x2="16" y2="20"/></svg>
)}
{category === 'Wallpaper' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3" width="4" height="18" rx="2"/><path d="M7.5 5H19v5H7.5"/><path d="M7.5 13h7v5h-7"/></svg>
)}
{category === 'Kitchen' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
)}
{category === 'Storage' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1.6"/><path d="M9 7v9a5 5 0 0 0 5 5h2"/></svg>
)}
{category === 'Guides' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2M4 12h2M4 18h2"/><path d="M9 6h11M9 12h11M9 18h11"/></svg>
)}
