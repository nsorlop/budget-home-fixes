---
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
}
const { title, description, type = 'website', pubDate, updatedDate, image } = Astro.props;
const siteName = 'Budget Home Fixes';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/images/hero-banner.jpg', Astro.site).toString();
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];

const jsonLd =
  type === 'article' && pubDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: [ogImage],
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
        author: { '@type': 'Organization', name: siteName },
        publisher: { '@type': 'Organization', name: siteName },
        mainEntityOfPage: canonicalURL.toString(),
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="p:domain_verify" content="72fc7946a2bff895ae68af22ba7d4c35" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {type === 'article' && (updatedDate ?? pubDate) && <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <style>
      :root {
        --bg: #fbf8f2;
        --surface: #ffffff;
        --text: #241f18;
        --muted: #6b6459;
        --accent: #c1571f;
        --accent-dark: #93400f;
        --accent-soft: #f6e6d8;
        --border: #ece3d4;
        --shadow-sm: 0 1px 2px rgba(36, 24, 8, 0.06);
        --shadow-md: 0 10px 30px -12px rgba(36, 24, 8, 0.18);
        --radius: 14px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, .brand {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
      }
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(251, 248, 242, 0.9);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--border);
        padding: 1rem 1.5rem;
      }
      .header-inner {
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        text-decoration: none;
        font-size: 1.15rem;
      }
      .brand-mark {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      nav {
        display: flex;
        gap: 1.5rem;
        font-size: 0.9rem;
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 500;
      }
      nav a:hover { color: var(--accent); }
      nav a[aria-current="page"] {
        color: var(--accent-dark);
        position: relative;
      }
      nav a[aria-current="page"]::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.4rem;
        height: 2px;
        background: var(--accent);
        border-radius: 2px;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }
      footer {
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
      }
      .footer-inner {
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
        text-align: center;
      }
      .footer-brand {
        font-size: 1rem;
        opacity: 0.85;
      }
      .footer-nav {
        display: flex;
        gap: 1.25rem;
        font-size: 0.85rem;
      }
      .footer-nav a { color: var(--muted); text-decoration: none; }
      .footer-nav a:hover { color: var(--accent); }
      .footer-note {
        color: var(--muted);
        font-size: 0.8rem;
        margin: 0;
      }
      a { color: var(--accent-dark); }
    </style>

    <style is:global>
      /* article content typography — .prose wraps <Content /> from markdown,
         which never carries this page's scoped style attribute, so this block
         must stay global to reach it. */
      .prose h2 {
        font-size: 1.5rem;
        margin-top: 2.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }
      .prose h2:first-of-type { border-top: none; padding-top: 0; }
      .prose p { color: var(--text); }
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.25rem 0;
        font-size: 0.95rem;
        box-shadow: var(--shadow-sm);
        border-radius: 10px;
        overflow: hidden;
      }
      .prose th, .prose td {
        padding: 0.6rem 0.9rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
      }
      .prose th {
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-weight: 600;
      }
      .prose tr:nth-child(even) td { background: #fdfcf9; }
      .prose a, .toc a { color: var(--accent-dark); }
      .prose h2, .prose h3 { scroll-margin-top: 5rem; }
      .prose h3 { font-size: 1.15rem; margin: 1.7rem 0 0.4rem; }
      .prose blockquote {
        margin: 1.5rem 0;
        padding: 0.2rem 1.1rem;
        border-left: 3px solid var(--accent);
        color: var(--muted);
      }
      .prose a { text-underline-offset: 2px; }
      .prose img { max-width: 100%; height: auto; }
      @media (max-width: 640px) {
        .prose table { display: block; overflow-x: auto; }
      }
      .prose ul, .prose ol { padding-left: 1.25rem; }
      .prose li { margin: 0.35rem 0; }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 5l8 7"/><path d="M6 11v9h12v-9"/></svg>
          </span>
          Budget Home Fixes
        </a>
        <nav>
          {navLinks.map((link) => (
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span class="brand footer-brand">
          <span class="brand-mark">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 5l8 7"/><path d="M6 11v9h12v-9"/></svg>
          </span>
          Budget Home Fixes
        </span>
        <nav class="footer-nav">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <p class="footer-note">
          Cost estimates are informational, not quotes. &copy; {new Date().getFullYear()} Budget Home Fixes.
        </p>
      </div>
    </footer>
  </body>
</html>
